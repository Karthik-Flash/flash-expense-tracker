# Copy to backend/.env for local dev. Never commit .env.

# Comma-separated list of frontend origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173

# Secret expected in the X-Ping-Token header of GET /health/db.
# Empty means /health/db answers 503 "ping token not configured".
PING_TOKEN=

# Optional. Defaults to a local SQLite file (backend/flash.db).
# Supabase: Session pooler string (Render free has no IPv6) plus ?sslmode=require.
# postgres:// and postgresql:// are switched to the pinned psycopg driver automatically.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# Optional. Owner of imported data until auth exists.
# OWNER_ID=00000000-0000-0000-0000-000000000001

# Login (D-078). The Supabase project URL, no trailing path.
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# The owner's login: "<auth user id>:<owner id>", comma-separated. Since 5C (D-129) it seeds
# app_users (the owner becomes admin on the first request) and is only a fallback after that.
# AUTH_USERS=00000000-0000-0000-0000-0000000000aa:00000000-0000-0000-0000-000000000001

# 5C (D-128): the project's secret API key (sb_secret_..., Supabase: Project Settings > API Keys).
# Server only: invites make logins and Delete my account removes them. Never in the frontend.
# SUPABASE_SECRET_KEY=
