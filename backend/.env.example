# Copy to backend/.env for local dev. Never commit .env.

# Comma-separated list of frontend origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173

# Secret for GET /health/db?token=... Leave empty locally to disable the endpoint.
PING_TOKEN=

# Optional. Defaults to a local SQLite file (backend/flash.db).
# Supabase: use the Session pooler string (Render free has no IPv6), switch the
# scheme to postgresql+psycopg:// and add ?sslmode=require. Example:
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
