#!/bin/sh
# Rejects AI attribution lines in commit messages (D-109): Co-Authored-By
# Claude/Anthropic, Claude-Session, "Generated with Claude Code".
# Enable once per clone: git config core.hooksPath .githooks
if LC_ALL=C grep -qiE '(^[[:space:]]*(co-authored-by:.*(claude|anthropic)|claude-session:)|generated with \[?claude code)' "$1"; then
  echo "commit-msg: remove the AI attribution line; this project keeps none (D-109)." >&2
  exit 1
fi
exit 0
