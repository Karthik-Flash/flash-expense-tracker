# Copy to frontend/.env for local dev. On Vercel, set the first three in Project Settings.
# All three are public: they end up in the browser bundle.
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Local dev only: the demo adapter with fake data, no login. Ignored by a production build.
# VITE_DEMO=1
